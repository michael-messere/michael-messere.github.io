@string{apj = {The Astrophysical Journal,}}
@string{mnras = {Monthly Notices of the Royal Astronomical Society,}}
@string{apjl = {The Astrophysical Journal Letters,}}

@comment{
  Add your publications below in BibTeX format.
  al-folio will automatically render them on the /publications/ page.

  Useful extra fields supported by al-folio:
    abbr      = {short label shown as badge, e.g. "ApJ"}
    abstract  = {paper abstract shown on expand}
    arxiv     = {arXiv ID, e.g. "2301.00001"}
    html      = {URL to published paper}
    pdf       = {path to local PDF or URL}
    selected  = {true} to feature on the About page
    preview   = {filename of thumbnail image in assets/img/publication_preview/}

  Example:

  @article{messere2024cgm,
    title     = {High Specific Energy Winds and the Circumgalactic Medium of Dwarf Galaxies},
    author    = {Messere, Michael and Bryan, Greg},
    journal   = apj,
    year      = {2024},
    abbr      = {ApJ},
    selected  = {true}
  }
}
